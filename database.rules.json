{
  "rules": {
    ".read": true,
    "leaderboards": {
      "$game": {
        ".write": false,
        "$entry": {
          ".write": "data.val() == null || (newData.child('score').val() > data.child('score').val() && newData.child('name').val() == data.child('name').val())",
          ".validate": "newData.hasChildren(['name', 'score']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('score').isNumber() && newData.child('score').val() > 100 && newData.child('score').val() <= 100000000"
        }
      }
    },
    "p2p_signaling": {
      "$gameId": {
        "$roomCode": {
          ".write": true,
          "host": {
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() == 'lobby' || newData.val() == 'playing' || newData.val() == 'ended')"
          },
          "heartbeat": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          }
        }
      }
    }
  }
}
